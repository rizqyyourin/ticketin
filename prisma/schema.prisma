// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User & RBAC ──────────────────────────────────────────────────────────────

model User {
  id        String     @id @default(cuid())
  userId    String     @unique // e.g. USR-001
  username  String     @unique
  email     String     @unique
  phone     String?
  password  String     // hashed
  status    UserStatus @default(active)
  roleId    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  role                Role?               @relation(fields: [roleId], references: [id])
  accounts            Account[]
  sessions            Session[]
  queueMemberships    QueueMember[]
  assignedTickets     ServiceRequest[]    @relation("AssignedAgent")
  comments            Comment[]
  activityLogs        ActivityLog[]
  knowledgeArticles   KnowledgeArticle[]
  notifications       Notification[]
}

enum UserStatus {
  active
  inactive
}

model Role {
  id          String     @id @default(cuid())
  roleId      String     @unique // e.g. ROLE-001
  name        String     @unique
  permissions Json       @default("{}")
  status      RoleStatus @default(active)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  users User[]
}

enum RoleStatus {
  active
  inactive
}

// ─── Queue ────────────────────────────────────────────────────────────────────

model Queue {
  id        String      @id @default(cuid())
  queueId   String      @unique // e.g. QUE-001
  name      String      @unique
  status    QueueStatus @default(active)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  members         QueueMember[]
  serviceRequests ServiceRequest[]
}

enum QueueStatus {
  active
  inactive
}

model QueueMember {
  id      String @id @default(cuid())
  userId  String
  queueId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  queue Queue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@unique([userId, queueId])
}

// ─── Contact ──────────────────────────────────────────────────────────────────

model Contact {
  id           String   @id @default(cuid())
  title        Title    @default(Mr)
  customerName String
  phone        String?
  email        String   @unique
  organization String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  serviceRequests ServiceRequest[]
}

enum Title {
  Mr
  Ms
}

// ─── Service Request ──────────────────────────────────────────────────────────

model ServiceRequest {
  id                    String    @id @default(cuid())
  ticketNumber          String    @unique // e.g. SR0001
  subject               String
  description           String    @db.Text
  category              String
  priority              Priority  @default(medium)
  status                Status    @default(new)
  dueDate               DateTime
  csatToken             String?   @unique // unique token for CSAT survey link
  csatSentAt            DateTime? // when CSAT email was last sent
  emailThreadId         String?   // anchor Message-ID for the email thread
  slaBreachedNotifiedAt DateTime? // when SLA breach notification was sent
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  contactId  String
  assignedTo String?
  queueId    String?

  contact       Contact        @relation(fields: [contactId], references: [id])
  assignedUser  User?          @relation("AssignedAgent", fields: [assignedTo], references: [id])
  queue         Queue?         @relation(fields: [queueId], references: [id])
  comments      Comment[]
  activityLogs  ActivityLog[]
  csatSurvey    CsatSurvey?
  notifications Notification[]
}

enum Priority {
  low
  medium
  high
}

enum Status {
  new
  open
  in_progress
  pending
  resolved
  closed
}

model Comment {
  id             String      @id @default(cuid())
  content        String      @db.Text
  authorId       String?     // null = customer comment via email
  role           CommentRole @default(agent)
  emailMessageId String?     // outbound Message-ID header (for threading)
  createdAt      DateTime    @default(now())

  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  author           User?          @relation(fields: [authorId], references: [id])
}

enum CommentRole {
  agent
  customer
  system
}

model ActivityLog {
  id        String          @id @default(cuid())
  type      ActivityLogType
  detail    String
  createdAt DateTime        @default(now())

  serviceRequestId String
  actorId          String?

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  actor          User?          @relation(fields: [actorId], references: [id])
}

enum ActivityLogType {
  created
  status_change
  assignment
  comment
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  body      String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum KnowledgeStatus {
  draft
  published
  archived
}

model KnowledgeArticle {
  id          String          @id @default(cuid())
  articleId   String          @unique // e.g. ART001
  title       String
  content     String          @db.Text
  type        String          // How-To Guide, FAQ, Troubleshooting, etc.
  ticketType  String          // Technical Support, Billing, etc.
  status      KnowledgeStatus @default(draft)
  authorId    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  author User? @relation(fields: [authorId], references: [id])
}

enum CsatRating {
  dissatisfied
  neutral
  satisfied
}

enum CsatTrigger {
  every_reply
  ticket_resolved
}

model CsatSurvey {
  id               String     @id @default(cuid())
  serviceRequestId String     @unique
  rating           CsatRating
  comment          String?    @db.Text
  submittedAt      DateTime   @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
}

model CsatSettings {
  id        String      @id @default(cuid())
  enabled   Boolean     @default(true)
  question  String      @default("How satisfied are you with our support?")
  thankYou  String      @default("Thank you for your feedback! It helps us improve.")
  trigger   CsatTrigger @default(ticket_resolved)
  updatedAt DateTime    @updatedAt
}

// ─── Notification ────────────────────────────────────────────────────────────

model Notification {
  id               String           @id @default(cuid())
  userId           String
  type             NotificationType
  title            String
  message          String           @db.Text
  isRead           Boolean          @default(false)
  serviceRequestId String?
  createdAt        DateTime         @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
}

enum NotificationType {
  sla_breached
  inbound_email
  ticket_assigned
}
