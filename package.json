{
  "name": "ticketin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others -n next,imap -c cyan,yellow \"next dev\" \"ts-node -r tsconfig-paths/register scripts/imap-poll.ts\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "dotenv -e .env -- ts-node --esm prisma/seed.ts",
    "email:poll": "ts-node -r tsconfig-paths/register scripts/imap-poll.ts",
    "email:poll:prod": "node --import tsx scripts/imap-poll.ts"
  },
  "prisma": {
    "seed": "ts-node --esm prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-label": "^2.1.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.20.0",
    "animate-ui": "^0.0.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "dotenv": "^17.4.2",
    "imapflow": "^1.3.5",
    "lucide-react": "^1.16.0",
    "mailparser": "^3.9.9",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0"
